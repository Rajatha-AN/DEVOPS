
pipeline {
    agent any

    environment {
        APP_DIR = "${WORKSPACE}/Exercise-9"
        VENV = "${WORKSPACE}/Exercise-9/venv"
        DEPLOY_DIR = "${WORKSPACE}/Exercise-9/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    cd "$APP_DIR"
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/pip" install -r python-flask-app/requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    cd "$APP_DIR"
                    "$VENV/bin/python" -m unittest discover \
                        -s python-flask-app -p 'test*.py'
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$APP_DIR/python-flask-app/app.py" "$DEPLOY_DIR/"
                    cp "$APP_DIR/python-flask-app/requirements.txt" "$DEPLOY_DIR/"
                    echo "Application files copied successfully."
                    ls -la "$DEPLOY_DIR"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                    fi

                    nohup "$VENV/bin/python" "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &

                    echo $! > "$DEPLOY_DIR/app.pid"
                    sleep 3
                    cat "$DEPLOY_DIR/app.log"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the running application...'
                sh '''
                    "$VENV/bin/python" -c "
import urllib.request
url = 'http://127.0.0.1:5000/'
with urllib.request.urlopen(url, timeout=10) as response:
    body = response.read().decode()
    print('HTTP Status:', response.status)
    print('Response:', body)
    assert response.status == 200
    assert body == 'Hello, Jenkins Multi-Stage Pipeline!'
"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
        always {
            sh '''
                if [ -f "$DEPLOY_DIR/app.pid" ]; then
                    kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                fi
            '''
        }
    }
}

