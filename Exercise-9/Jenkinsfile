pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    cd ${WORKSPACE}/Exercise-9
                    python3 -m pip install -r python-flask-app/requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh '''
                    cd ${WORKSPACE}/Exercise-9
                    python3 -m unittest discover -s python-flask-app
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p ${WORKSPACE}/Exercise-9/python-app-deploy
                    cp ${WORKSPACE}/Exercise-9/python-flask-app/app.py \
                       ${WORKSPACE}/Exercise-9/python-app-deploy/
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                    nohup python3 \
                    ${WORKSPACE}/Exercise-9/python-app-deploy/app.py \
                    > ${WORKSPACE}/Exercise-9/python-app-deploy/app.log 2>&1 &

                    echo $! > ${WORKSPACE}/Exercise-9/python-app-deploy/app.pid
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application...'
                sh '''
                    cd ${WORKSPACE}/Exercise-9
                    python3 python-flask-app/test_app.py
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
