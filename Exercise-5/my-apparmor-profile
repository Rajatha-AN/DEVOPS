#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {

  # Allow Python inside the Docker container
  /usr/local/bin/python3.8 rix,
  /usr/local/bin/python rix,

  # Allow Python and application libraries
  /usr/local/lib/** mr,
  /usr/lib/** mr,
  /lib/** mr,

  # Allow application files
  /app/** rwk,

  # Allow Flask app to bind to port 5000
  network inet stream,
    network inet dgram,

  # Restrict access to sensitive system files
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /etc/passwd w,
  deny /etc/group w,

  # Prevent execution of common system binaries
  deny /bin/** x,
  deny /usr/bin/** x,

  # Capability restrictions
  capability net_bind_service,
  deny capability sys_admin,
}
